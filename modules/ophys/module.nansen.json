{
  "schemaType": "nansen.module",
  "schemaVersion": "0.1.0",
  "id": "ophys",
  "version": "0.1.0",
  "title": "Two-photon imaging",
  "description": "Motion correction, ROI detection, signal extraction and ΔF/F for two-photon recordings, native in both languages; SciScan and TIFF readers; and suite2p, NoRMCorre and imviewer where they are installed.",
  "fragments": [
    "fragments/cranial_window.fragment.nansen.json",
    "fragments/fov_position.fragment.nansen.json",
    "fragments/fov_region.fragment.nansen.json",
    "fragments/image_stats.fragment.nansen.json",
    "fragments/imaging.fragment.nansen.json",
    "fragments/scan.fragment.nansen.json"
  ],
  "methods": [
    "methods/align_sessions.method.nansen.json",
    "methods/caiman_deconvolution.method.nansen.json",
    "methods/cnmf.method.nansen.json",
    "methods/compute_dff.method.nansen.json",
    "methods/roi_images.method.nansen.json",
    "methods/crop.method.nansen.json",
    "methods/deconvolve.method.nansen.json",
    "methods/deep_interpolation.method.nansen.json",
    "methods/deinterleave.method.nansen.json",
    "methods/denoise.method.nansen.json",
    "methods/detect_rois.method.nansen.json",
    "methods/downsample.method.nansen.json",
    "methods/export_nwb.method.nansen.json",
    "methods/export_stack.method.nansen.json",
    "methods/export_tiff.method.nansen.json",
    "methods/extract.method.nansen.json",
    "methods/extract_signals.method.nansen.json",
    "methods/find_plane.method.nansen.json",
    "methods/flowreg.method.nansen.json",
    "methods/flufinder.method.nansen.json",
    "methods/fov_region.method.nansen.json",
    "methods/image_stats.method.nansen.json",
    "methods/motion_correction.method.nansen.json",
    "methods/normcorre.method.nansen.json",
    "methods/open_in_imviewer.method.nansen.json",
    "methods/quicky.method.nansen.json",
    "methods/read_metadata.method.nansen.json",
    "methods/setup_variables.method.nansen.json",
    "methods/suite2p.method.nansen.json"
  ],
  "fileAdapters": [
    "adapters/binary_stack.fileAdapter.nansen.json",
    "adapters/caiman_rois.fileAdapter.nansen.json",
    "adapters/extract_rois.fileAdapter.nansen.json",
    "adapters/hdf5_stack.fileAdapter.nansen.json",
    "adapters/nansen_roi_array.fileAdapter.nansen.json",
    "adapters/prairie_tseries.fileAdapter.nansen.json",
    "adapters/scanimage_tiff.fileAdapter.nansen.json",
    "adapters/sciscan_raw.fileAdapter.nansen.json",
    "adapters/suite2p_binary.fileAdapter.nansen.json",
    "adapters/suite2p_rois.fileAdapter.nansen.json",
    "adapters/thorlabs_tiffs.fileAdapter.nansen.json",
    "adapters/image_files.fileAdapter.nansen.json",
    "adapters/norpix_seq.fileAdapter.nansen.json",
    "adapters/tsm_stack.fileAdapter.nansen.json",
    "adapters/tiff_stack.fileAdapter.nansen.json",
    "adapters/video_file.fileAdapter.nansen.json"
  ],
  "pipelines": [
    "pipelines/preprocess.pipeline.nansen.json"
  ],
  "presets": [
    "presets/motion_correction.thorough.options.nansen.json"
  ],
  "addons": [
    {
      "id": "normcorre",
      "title": "NoRMCorre",
      "language": "matlab",
      "source": {
        "github": "flatironinstitute/NoRMCorre"
      },
      "check": "normcorre",
      "description": "Rigid and piecewise rigid motion correction (ophys.normcorre)",
      "url": "https://github.com/flatironinstitute/NoRMCorre"
    },
    {
      "id": "caiman-matlab",
      "title": "CaImAn (MATLAB)",
      "language": "matlab",
      "source": {
        "github": "flatironinstitute/CaImAn-MATLAB"
      },
      "check": "deconvolveCa",
      "description": "Deconvolution (ophys.caiman_deconvolution)",
      "url": "https://github.com/flatironinstitute/CaImAn-MATLAB"
    },
    {
      "id": "extract",
      "title": "EXTRACT",
      "language": "matlab",
      "source": {
        "github": "schnitzer-lab/EXTRACT-public"
      },
      "check": "extractor",
      "description": "Cell extraction (ophys.extract); needs the Image Processing, Statistics, Signal Processing and Parallel Computing toolboxes",
      "url": "https://github.com/schnitzer-lab/EXTRACT-public"
    },
    {
      "id": "flow-registration",
      "title": "Flow-Registration",
      "language": "matlab",
      "source": {
        "github": "FlowRegSuite/flow_registration"
      },
      "check": "OF_options",
      "description": "Non-rigid motion correction by optical flow (ophys.flowreg); its solver is compiled when it is installed",
      "url": "https://github.com/FlowRegSuite/flow_registration",
      "setup": "core/make.m"
    },
    {
      "id": "nansen-dev",
      "title": "NANSEN dev apps",
      "language": "matlab",
      "source": {
        "github": "VervaekeLab/NANSEN"
      },
      "check": "imviewer",
      "description": "imviewer and flufinder (ophys.open_in_imviewer, ophys.flufinder), put on the path after this NANSEN; imviewer also needs the Widgets Toolbox - Compatibility Support (File Exchange 66235)",
      "url": "https://github.com/VervaekeLab/NANSEN",
      "pathOrder": "end"
    },
    {
      "id": "suite2p",
      "title": "suite2p",
      "language": "python",
      "source": {
        "pip": "suite2p"
      },
      "check": "suite2p",
      "description": "Registration, cell detection and signals (ophys.suite2p)",
      "url": "https://github.com/MouseLand/suite2p"
    },
    {
      "id": "deepinterpolation",
      "title": "DeepInterpolation",
      "language": "python",
      "source": {
        "pip": "deepinterpolation @ git+https://github.com/AllenInstitute/deepinterpolation"
      },
      "check": "deepinterpolation",
      "description": "Denoising with a trained network (ophys.deep_interpolation); also needs tensorflow and h5py",
      "url": "https://github.com/AllenInstitute/deepinterpolation"
    },
    {
      "id": "caiman",
      "title": "CaImAn",
      "language": "python",
      "source": {
        "conda": "caiman"
      },
      "check": "caiman",
      "description": "Deconvolution (ophys.caiman_deconvolution)",
      "url": "https://github.com/flatironinstitute/CaImAn"
    },
    {
      "id": "tifffile",
      "title": "tifffile",
      "language": "python",
      "source": {
        "pip": "tifffile"
      },
      "check": "tifffile",
      "description": "TIFF and ScanImage files (ophys.tiff_stack, ophys.scanimage_tiff)",
      "url": "https://github.com/cgohlke/tifffile"
    }
  ],
  "dashboard": [
    "dashboard/fovmap.js",
    "dashboard/roireview.js",
    "dashboard/dffexplorer.js"
  ]
}
