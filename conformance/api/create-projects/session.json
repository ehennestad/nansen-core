          "description": "From a DSM config",
          "entityTypes": [
            {
              "name": "subject",
              "title": "Subjects",
              "fragments": [
                "core.notes",
                "core.subject"
              ],
              "rows": 0
            },
            {
              "name": "session",
              "title": "Sessions",
              "fragments": [
                "core.notes"
              ],
              "rows": 0
            }
          ],
          "modules": [
            {
              "id": "core"
            }
          ],
          "dataset": {
            "environment": "laptop",
            "roots": [
              {
                "dataLocation": "raw",
                "path": "${case}/data/raw",
                "available": false
              },
              {
                "dataLocation": "processed",
                "path": "${case}/data/processed",
                "available": false
              }
            ]
          }
        }
      }
    },
    {
      "request": {
        "id": 4,
        "method": "project.create",
        "params": {
          "path": "${scratch}/fresh",
          "name": "Again",
          "datasetSource": "${case}/dataset.dsm.json"
        }
      },
      "expect": {
        "error": "folder-not-empty"
