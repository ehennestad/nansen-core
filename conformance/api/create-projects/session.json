                "rows": 2
              },
              {
                "name": "session",
                "fragments": [
                  "core.notes",
                  "legacy.session"
                ],
                "rows": 2
              }
            ]
          },
          "warnings": [
            "data location 'Processed', Session ID: read by the function RatNav.datalocation.getSessionID; register an extractor named 'getSessionID'",
            "data location 'Processed', Experiment Date: combines several folder levels, which has no DSM rule; left out",
            "data location 'Scratch': no root path, left out",
            "variable 'MotionCorrected': no built-in file adapter for 'ImageStack' .tif files; left out",
            "table 'Sessions': column 'DataLocation' holds values with no table type; left out",
            "table 'Sessions': column 'Progress' holds values with no table type; left out",
            "table 'Sessions': m110/m110-001 appears twice; kept the first",
            "table 'Sessions': 1 row(s) with no subject_id or session_id; left out"
          ]
        }
      }
    },
    {
      "request": {
        "id": 8,
        "method": "project.info"
      },
      "expect": {
        "result": {
