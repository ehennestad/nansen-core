{
  "steps": [
    {
      "request": {
        "id": 1,
        "method": "demo.create",
        "params": {
          "path": "${scratch}/demo"
        }
      },
      "expect": {
        "result": {
          "name": "TwoPhotonDemo",
          "title": "Two-photon demo",
          "entityTypes": [
            {
              "name": "subject",
              "rows": 4
            },
            {
              "name": "session",
              "rows": 14
            }
          ]
        }
      }
    },
    {
      "request": {
        "id": 2,
        "method": "demo.create",
        "params": {
          "path": "${scratch}/demo"
        }
      },
      "expect": {
        "error": "folder-not-empty"
      }
    },
    {
      "request": {
        "id": 3,
        "method": "project.create",
        "params": {
          "path": "${scratch}/fresh",
          "name": "Fresh",
          "title": "Fresh start",
          "description": "From a DSM config",
          "datasetSource": "${case}/dataset.dsm.json",
          "modules": [
            "core"
          ],
          "entityTypes": true
        }
      },
      "expect": {
        "result": {
          "name": "Fresh",
