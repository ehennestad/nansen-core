{
  "steps": [
    {
      "request": {
        "id": 1,
        "method": "demo.create",
        "params": {
          "path": "${scratch}/demo"
        }
      },
      "expect": {
        "result": {
          "name": "TwoPhotonDemo",
          "title": "Two-photon demo",
          "entityTypes": [
            {
              "name": "subject",
              "rows": 4
            },
            {
              "name": "session",
              "rows": 14
            }
          ]
        }
      }
    },
    {
      "request": {
        "id": 2,
        "method": "demo.create",
        "params": {
          "path": "${scratch}/demo"
        }
      },
      "expect": {
        "error": "folder-not-empty"
      }
    },
    {
      "request": {
        "id": 3,
        "method": "project.create",
        "params": {
          "path": "${scratch}/fresh",
          "name": "Fresh",
          "title": "Fresh start",
          "description": "From a DSM config",
          "datasetSource": "${case}/dataset.dsm.json",
          "modules": [
            "core"
          ],
          "entityTypes": true
        }
      },
      "expect": {
        "result": {
          "name": "Fresh",
          "title": "Fresh start",
          "description": "From a DSM config",
          "entityTypes": [
            {
              "name": "subject",
              "title": "Subjects",
              "fragments": [
                "core.notes"
              ],
              "rows": 0
            },
            {
              "name": "session",
              "title": "Sessions",
              "fragments": [
                "core.notes"
              ],
              "rows": 0
            }
          ],
          "modules": [
            {
              "id": "core"
            }
          ],
          "dataset": {
            "environment": "laptop",
            "roots": [
              {
                "dataLocation": "raw",
                "path": "${case}/data/raw",
                "available": false
              },
              {
                "dataLocation": "processed",
                "path": "${case}/data/processed",
                "available": false
              }
            ]
          }
        }
      }
    },
    {
      "request": {
        "id": 4,
        "method": "project.create",
        "params": {
          "path": "${scratch}/fresh",
          "name": "Again",
          "datasetSource": "${case}/dataset.dsm.json"
        }
      },
      "expect": {
        "error": "folder-not-empty"
      }
    },
    {
      "request": {
        "id": 5,
        "method": "project.create",
        "params": {
          "path": "${scratch}/plain",
          "name": "Plain"
        }
      },
      "expect": {
        "result": {
          "name": "Plain",
          "title": "Plain",
          "entityTypes": [],
          "dataset": null
        }
      }
    },
    {
      "request": {
        "id": 6,
        "method": "project.create",
        "params": {
          "path": "${scratch}/missing",
          "name": "Missing",
          "datasetSource": "${case}/nothing.dsm.json"
        }
      },
      "expect": {
        "error": "file-not-found"
      }
    },
    {
      "request": {
        "id": 61,
        "method": "project.setDataset",
        "params": {
          "datasetSource": "${case}/dataset.dsm.json",
          "entityTypes": true
        }
      },
      "expect": {
        "result": {
          "name": "Plain",
          "entityTypes": [
            {
              "name": "subject",
              "fragments": [],
              "rows": 0
            },
            {
              "name": "session",
              "fragments": [],
              "rows": 0
            }
          ],
          "dataset": {
            "environment": "laptop",
            "roots": [
              {
                "dataLocation": "raw",
                "path": "${case}/data/raw"
              },
              {
                "dataLocation": "processed",
                "path": "${case}/data/processed"
              }
            ]
          }
        }
      }
    },
    {
      "request": {
        "id": 62,
        "method": "project.setDataset",
        "params": {
          "datasetSource": "${case}/dataset.dsm.json"
        }
      },
      "expect": {
        "error": "dataset-exists"
      }
    },
    {
      "request": {
        "id": 7,
        "method": "legacy.import",
        "params": {
          "source": "${case}/export.json",
          "path": "${scratch}/imported"
        }
      },
      "expect": {
        "result": {
          "project": {
            "name": "RatNav",
            "title": "Rat Navigation",
            "description": "Imported from dev",
            "entityTypes": [
              {
                "name": "subject",
                "fragments": [
                  "core.notes",
                  "legacy.subject"
                ],
                "rows": 2
              },
              {
                "name": "session",
                "fragments": [
                  "core.notes",
                  "legacy.session"
                ],
                "rows": 2
              }
            ]
          },
          "warnings": [
            "data location 'Processed', Session ID: read by the function RatNav.datalocation.getSessionID; register an extractor named 'getSessionID'",
            "data location 'Processed', Experiment Date: combines several folder levels, which has no DSM rule; left out",
            "data location 'Scratch': no root path, left out",
            "variable 'MotionCorrected': no built-in file adapter for 'ImageStack' .tif files; left out",
            "table 'Sessions': column 'DataLocation' holds values with no table type; left out",
            "table 'Sessions': column 'Progress' holds values with no table type; left out",
            "table 'Sessions': m110/m110-001 appears twice; kept the first",
            "table 'Sessions': 1 row(s) with no subject_id or session_id; left out"
          ]
        }
      }
    },
    {
      "request": {
        "id": 8,
        "method": "project.info"
      },
      "expect": {
        "result": {
          "name": "RatNav"
        }
      }
    },
    {
      "request": {
        "id": 9,
        "method": "legacy.import",
        "params": {
          "source": "${case}/missing.json",
          "path": "${scratch}/none"
        }
      },
      "expect": {
        "error": "file-not-found"
      }
    }
  ]
}
