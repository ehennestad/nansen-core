                "default": false
              },
              {
                "name": "qc_note",
                "dataType": "string"
              }
            ]
          },
          "entityType": "session"
        }
      },
      "expect": {
        "result": {
          "id": "lab.qc",
          "version": "1.0.0",
          "title": "Quality control",
          "computed": false
        }
      }
    },
