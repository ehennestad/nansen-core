    {
      "request": {
        "id": 7,
        "method": "legacy.import",
        "params": {
          "source": "${case}/export.json",
          "path": "${scratch}/imported"
        }
      },
      "expect": {
        "result": {
          "project": {
            "name": "RatNav",
