{
  "steps": [
    {
      "request": {
        "method": "project.open",
        "id": 1,
        "params": {
          "path": "${project}"
        }
      },
      "expect": {
        "result": {
          "name": "TwoPhoton"
        }
      }
    },
    {
      "request": {
        "method": "fragments.create",
        "id": 2,
        "params": {
