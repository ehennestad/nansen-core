            "schemaVersion": "0.1.0",
            "id": "qc",
            "version": "1.0.0",
            "columns": [
              {
                "name": "quality",
                "dataType": "string",
                "choices": [
                  "good",
                  "poor"
                ]
              },
              {
                "name": "checked",
                "dataType": "boolean",
                "default": false
              }
            ]
          },
          "entityType": "session"
        }
      },
      "expect": {
        "result": {
          "id": "qc"
        }
      }
    },
    {
      "request": {
        "method": "entities.update",
        "id": 3,
        "params": {
          "entityType": "session",
          "key": {
            "subject_id": "m110",
            "session_id": "m110-20250523-001"
          },
          "values": {
            "quality": "poor",
            "checked": true
          }
        }
      },
      "expect": {
        "result": {
          "values": {
            "quality": "poor",
            "checked": true
          }
        }
      }
    },
    {
      "request": {
        "method": "entities.update",
        "id": 4,
        "params": {
          "entityType": "session",
