{
  "steps": [
    {
      "request": {
        "method": "files.resolve",
        "id": 1,
        "params": {
          "path": ""
        }
      },
      "expect": {
        "error": "no-project"
      }
    },
    {
      "request": {
        "method": "project.open",
        "id": 2,
        "params": {
          "path": "${project}"
        }
      },
      "expect": {
        "result": {
          "name": "TwoPhoton"
        }
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 3,
        "params": {
          "path": ""
        }
      },
      "expect": {
        "result": {
          "exists": true,
          "isFolder": true
        }
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 4,
        "params": {
          "path": "tables/session.csv"
        }
      },
      "expect": {
        "result": {
          "exists": true,
          "isFolder": false
        }
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 5,
        "params": {
          "path": "tables/../tables/./session.csv"
        }
      },
      "expect": {
        "result": {
          "exists": true,
          "isFolder": false
        }
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 6,
        "params": {
          "path": "no/such/file.txt"
        }
      },
      "expect": {
        "result": {
          "exists": false,
          "isFolder": false
        }
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 7,
        "params": {
          "path": "../outside"
        }
      },
      "expect": {
        "error": "invalid-params"
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 8,
        "params": {
          "path": "tables/../../outside"
        }
      },
      "expect": {
        "error": "invalid-params"
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 9,
        "params": {
          "path": "/etc/passwd"
        }
      },
      "expect": {
        "error": "invalid-params"
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 10,
        "params": {
          "path": "C:/Windows"
        }
      },
      "expect": {
        "error": "invalid-params"
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 11,
        "params": {
          "dataLocation": "processed",
          "rootStoragePath": "analysis-mac",
          "path": "m110/session-1"
        }
      },
      "expect": {
        "result": {
          "exists": false
        }
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 12,
        "params": {
          "dataLocation": "processed",
          "path": "../.."
        }
      },
      "expect": {
        "error": "invalid-params"
      }
    },
    {
      "request": {
        "method": "files.resolve",
        "id": 13,
        "params": {
          "dataLocation": "nowhere",
          "path": "x"
        }
      },
      "expect": {
        "error": "unknown-location"
      }
    },
    {
      "request": {
        "method": "files.reveal",
        "id": 14,
        "params": {
          "path": "no/such/folder"
        }
      },
      "expect": {
        "error": "file-not-found"
      }
    },
    {
      "request": {
        "method": "files.list",
        "id": 15,
        "params": {
          "path": "tables"
        }
      },
      "expect": {
        "result": {
          "exists": true,
          "isFolder": true,
          "truncated": false,
          "entries": [
            {
              "name": "session.csv",
              "isFolder": false
            },
            {
              "name": "session.table.nansen.json",
              "isFolder": false
            },
            {
              "name": "subject.csv",
              "isFolder": false
            },
            {
              "name": "subject.table.nansen.json",
              "isFolder": false
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "files.list",
        "id": 16,
        "params": {
          "path": "fragments/.."
        }
      },
      "expect": {
        "result": {
          "entries": [
            {
              "name": "fragments",
              "isFolder": true,
              "size": null
            },
            {
              "name": "tables",
              "isFolder": true
            },
            {
              "name": "dataset.dsm.json",
              "isFolder": false
            },
            {
              "name": "project.nansen.json",
              "isFolder": false
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "files.list",
        "id": 17,
        "params": {
          "path": "tables",
          "limit": 2
        }
      },
      "expect": {
        "result": {
          "truncated": true,
          "entries": [
            {
              "name": "session.csv"
            },
            {
              "name": "session.table.nansen.json"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "files.list",
        "id": 18,
        "params": {
          "path": "tables/session.csv"
        }
      },
      "expect": {
        "error": "invalid-params"
      }
    },
    {
      "request": {
        "method": "files.list",
        "id": 19,
        "params": {
          "path": "no/such/folder"
        }
      },
      "expect": {
        "error": "file-not-found"
      }
    },
    {
      "request": {
        "method": "files.list",
        "id": 20,
        "params": {
          "path": "../outside"
        }
      },
      "expect": {
        "error": "invalid-params"
      }
    },
    {
      "request": {
        "method": "files.open",
        "id": 21,
        "params": {
          "path": "tables"
        }
      },
      "expect": {
        "error": "invalid-params"
      }
    },
    {
      "request": {
        "method": "files.open",
        "id": 22,
        "params": {
          "path": "no/such/file.txt"
        }
      },
      "expect": {
        "error": "file-not-found"
      }
    },
    {
      "request": {
        "method": "files.open",
        "id": 23,
        "params": {
          "path": "../outside.txt"
        }
      },
      "expect": {
        "error": "invalid-params"
      }
    }
