    {
      "schemaType": "nansen.dataVariable",
      "schemaVersion": "0.1.0",
      "name": "SessionConfig",
      "entityType": "session",
      "dataLocation": "rawdata",
      "filePattern": "SessionConfig",
      "fileName": "{session_id}_config.json",
      "fileAdapter": "json"
    },
    {
      "schemaType": "nansen.dataVariable",
      "schemaVersion": "0.1.0",
      "entityType": "session",
      "dataLocation": "processed",
      "name": "TwoPhotonSeries_Corrected",
      "subfolder": "motion_corrected",
      "fileName": "{session_id}_two_photon_corrected.raw",
      "fileAdapter": "ophys.binary_stack"
    }
