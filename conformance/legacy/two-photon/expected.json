{
  "description": "A dev project with two data locations, file path settings and session and subject tables. Covers each folder rule (index range, regular expression, function, several levels), the defaults for ids, adapters with and without a built-in equivalent, derived and skipped columns, rows without a key and duplicates, and notes: on kept, duplicate and left-out rows, without a time, of an unknown type, and two in the same second; and a filtered table, which becomes a view (one of its rows is not in the master table).",
  "project": {
    "schemaType": "nansen.project",
    "schemaVersion": "0.1.0",
    "name": "RatNav",
    "title": "Rat Navigation",
    "description": "Imported from dev",
    "dataset": "dataset.dsm.json",
    "entityTypes": [
      {
        "name": "subject",
        "title": "Subjects",
        "fragments": [
          "core.notes",
          "core.subject"
        ]
      },
      {
        "name": "session",
        "title": "Sessions",
        "fragments": [
          "core.notes",
          "legacy.session"
        ]
      }
    ],
    "modules": [
      {
        "id": "core"
      }
    ]
  },
  "dataset": {
    "schemaVersion": "0.1.0",
    "entityTypes": [
      {
        "name": "subject",
        "identifierRef": "subject_id"
      },
      {
        "name": "session",
        "identifierRef": "session_id"
      }
    ],
    "metadataDefinitions": {
      "subject_id": {
        "name": "subject_id",
        "dataType": "string",
        "ofEntity": "subject"
      },
      "session_id": {
        "name": "session_id",
        "dataType": "string",
        "ofEntity": "session"
      },
      "session_date": {
        "name": "session_date",
        "dataType": "date",
        "ofEntity": "session"
      }
    },
    "dataLocations": [
      {
        "identifier": "rawdata",
        "displayName": "Rawdata",
        "dataCategory": "raw",
        "access": "read",
        "sourceType": "filesystem",
        "filesystemSource": {
          "rootStoragePaths": [
            {
              "identifier": "local",
              "path": "/data/rawdata",
              "volumeName": "LabDisk"
            }
          ],
          "entityLayout": [
            {
              "name": "subjects",
              "entityType": "subject",
              "matchPattern": "^m\\d{3}$",
              "excludePatterns": [
                "^\\.",
                "old"
              ]
            },
            {
              "name": "dates",
              "matchPattern": ".",
              "excludePatterns": [
                "^\\."
              ]
            },
            {
              "name": "sessions",
              "entityType": "session",
              "matchPattern": "session",
              "excludePatterns": [
                "^\\."
              ],
              "filePatterns": [
                {
                  "name": "SessionConfig",
                  "pattern": "config\\.json$",
                  "cardinality": "one"
                }
              ]
            }
          ],
          "metadataMapping": [
            {
              "metadataRef": "subject_id",
              "extraction": {
                "method": "substring",
                "pattern": ":",
                "entityLayoutLevel": "subjects"
              }
            },
            {
              "metadataRef": "session_id",
              "extraction": {
                "method": "regex",
                "pattern": "m\\d{3}-\\d{3}",
                "entityLayoutLevel": "sessions"
              }
            },
            {
              "metadataRef": "session_date",
              "extraction": {
                "method": "substring",
                "pattern": ":10",
                "entityLayoutLevel": "dates",
                "valueFormat": "yyyy_MM_dd"
              }
            }
          ]
        }
      },
      {
        "identifier": "processed",
        "displayName": "Processed",
        "dataCategory": "processed",
        "access": "readwrite",
        "sourceType": "filesystem",
        "filesystemSource": {
          "rootStoragePaths": [
            {
              "identifier": "root1",
              "path": "/data/processed"
            }
          ],
          "entityLayout": [
            {
              "name": "subjects",
              "entityType": "subject",
              "matchPattern": ".",
              "excludePatterns": [
                "^\\."
              ]
            },
            {
              "name": "sessions",
              "entityType": "session",
              "matchPattern": ".",
              "excludePatterns": [
                "^\\."
              ]
            }
          ],
          "metadataMapping": [
            {
              "metadataRef": "subject_id",
              "extraction": {
                "method": "substring",
                "pattern": ":",
                "entityLayoutLevel": "subjects"
              }
            },
            {
              "metadataRef": "session_id",
              "extraction": {
                "method": "function",
                "extractorFunction": "getSessionID"
              }
            }
          ]
        }
      }
    ]
  },
  "fragments": [
    {
      "schemaType": "nansen.fragment",
      "schemaVersion": "0.1.0",
      "id": "legacy.session",
      "version": "1.0.0",
      "title": "Columns imported from the Sessions table",
      "columns": [
        {
          "name": "Time",
          "dataType": "string"
        },
        {
          "name": "NumRois",
          "dataType": "integer"
        },
        {
          "name": "Quality",
          "dataType": "number"
        },
        {
          "name": "Reviewed",
          "dataType": "boolean",
          "default": false
        }
      ]
    }
  ],
  "dataVariables": [
    {
      "schemaType": "nansen.dataVariable",
      "schemaVersion": "0.1.0",
      "name": "RoiArray",
      "entityType": "session",
      "dataLocation": "processed",
      "subfolder": "roi_data",
      "fileName": "{session_id}_roi_array.mat",
      "fileAdapter": "mat"
    },
    {
      "schemaType": "nansen.dataVariable",
      "schemaVersion": "0.1.0",
      "name": "SessionConfig",
      "entityType": "session",
      "dataLocation": "rawdata",
      "filePattern": "SessionConfig",
      "fileName": "{session_id}_config.json",
      "fileAdapter": "json"
    }
  ],
