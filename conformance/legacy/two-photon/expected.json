        "sourceType": "filesystem",
        "filesystemSource": {
          "rootStoragePaths": [
            {
              "identifier": "local",
              "path": "/data/rawdata",
              "volumeName": "LabDisk"
            }
          ],
          "entityLayout": [
            {
              "name": "subjects",
              "entityType": "subject",
              "matchPattern": "^m\\d{3}$",
              "excludePatterns": [
