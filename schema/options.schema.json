{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nansen:schema:options",
  "title": "NANSEN options preset",
  "description": "A saved set of options for a method, in options/<methodId>/<name>.options.nansen.json. The values are validated against the options schema of the method declaration, filled with its defaults.",
  "type": "object",
  "required": ["schemaType", "schemaVersion", "method", "name", "values"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaType": { "const": "nansen.options" },
    "schemaVersion": { "type": "string", "pattern": "^0\\.1\\.\\d+$" },
    "method": { "$ref": "#/definitions/methodRef" },
    "name": { "type": "string", "description": "Preset name, e.g. 'default' or 'fast'." },
    "description": { "type": "string" },
    "values": { "type": "object" }
  },
  "definitions": {
    "methodRef": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    }
  }
}
