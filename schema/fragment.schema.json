{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nansen:schema:fragment",
  "title": "NANSEN fragment",
  "description": "A named group of columns that can be added to an entity type, for example notes, progress or a user's own table variables. A fragment has its own version: a table records which version of each fragment its columns follow.",
  "type": "object",
  "required": ["schemaType", "schemaVersion", "id", "version", "columns"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaType": { "const": "nansen.fragment" },
    "schemaVersion": { "type": "string", "pattern": "^0\\.1\\.\\d+$" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "Dotted identifier, for example 'notes' or 'ophys.qc'."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of this fragment's definition, independent of schemaVersion."
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/column" }
    },
    "compute": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "description": "Makes the fragment computed: the method (serial, on the fragment's entity type) returns a struct/dict with a value per column, and updating the fragment writes them to the table. NANSEN's table variables.",
      "properties": {
        "method": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][A-Za-z0-9_]*)*$" }
      }
    }
  },
  "definitions": {
    "column": {
      "type": "object",
      "required": ["name", "dataType"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "dataType": { "$ref": "#/definitions/dataType" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "unit": { "type": "string", "description": "Unit of measurement, ideally UCUM (e.g. 'um', 'Hz')." },
        "default": {
          "type": ["string", "number", "boolean", "null"],
          "description": "Value given to existing rows when the fragment is added, and to new rows. Dates and datetimes are written as in the CSV format."
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "For a string column: the values it may take (besides none). The app edits it with a list, and the API refuses other values. The CSV is read as written."
        }
      },
      "allOf": [
        { "if": { "properties": { "dataType": { "const": "boolean" } } }, "then": { "required": ["default"] } },
        { "if": { "required": ["choices"] }, "then": { "properties": { "dataType": { "const": "string" } } } }
      ]
    },
    "dataType": {
      "type": "string",
      "enum": ["string", "integer", "number", "boolean", "date", "datetime"]
    }
  }
}
