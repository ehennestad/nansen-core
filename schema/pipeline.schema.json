{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nansen:schema:pipeline",
  "title": "NANSEN pipeline",
  "description": "An ordered list of method steps to run on each entity, in pipelines/<id>.pipeline.nansen.json or listed by a module. Queueing a pipeline makes one chain of tasks per entity: each step's task waits for the one before it, and is cancelled if that one does not complete.",
  "type": "object",
  "required": ["schemaType", "schemaVersion", "id", "version", "entityType", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaType": { "const": "nansen.pipeline" },
    "schemaVersion": { "type": "string", "pattern": "^0\\.1\\.\\d+$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][A-Za-z0-9_]*)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "entityType": { "type": "string", "pattern": "^([A-Za-z][A-Za-z0-9_]*|\\*)$" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method"],
        "additionalProperties": false,
        "properties": {
          "method": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][A-Za-z0-9_]*)*$" },
          "title": { "type": "string" },
          "preset": { "type": "string", "description": "A preset of the method; its values start the step's options." },
          "options": { "type": "object", "description": "Option values over the preset (or the defaults)." }
        }
      }
    },
    "assignWhen": {
      "type": "array",
      "description": "Rows added by a sync get this pipeline when they pass every filter (as a view's filters, on the row's values and the attributes read from its names), unless a pipeline before it in the project's order takes them. Needs the core.pipeline column.",
      "items": {
        "type": "object",
        "required": ["column", "op"],
        "additionalProperties": false,
        "properties": {
          "column": { "type": "string" },
          "op": { "enum": ["in", "range", "is", "contains", "empty", "notEmpty"] },
          "values": { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } },
          "min": { "type": ["string", "number"] },
          "max": { "type": ["string", "number"] },
          "value": { "type": "boolean" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
